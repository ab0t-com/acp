    {"name": "A.3", "file": "build/\n!build/keep.txt\n", "paths": {
      "build/x": true, "build/keep.txt": true}},
    {"name": "A.4", "file": "/build\n", "paths": {
      "build": true, "build/x": true, "src/build/x": false}},
    {"name": "A.5", "file": "doc/*.txt\n", "paths": {
      "doc/a.txt": true, "doc/sub/a.txt": false, "x/doc/a.txt": false}},
    {"name": "A.6", "file": "**/foo\n", "paths": {
      "foo": true, "a/b/foo": true, "a/foo/x": true, "foox": false}},
    {"name": "A.7", "file": "a/**/b\n", "paths": {
