    {"name": "A.8", "file": "foo/**\n!foo/keep\n", "paths": {
      "foo/x": true, "foo/keep": false, "foo/keep/y": true, "foo": false}},
    {"name": "A.9", "file": "*\n!*.py\n", "paths": {
      "a.py": false, "src/a.py": true, "README": true}},
    {"name": "A.10", "file": "\\#notes\n\\!bang\ntrail\\ \n", "paths": {
      "#notes": true, "!bang": true, "trail ": true, "trail": false}},
    {"name": "A.11", "file": "a?c\n", "paths": {
      "abc": true, "ac": false, "a/c": false}},
    {"name": "A.12", "file": "Build/\n", "paths": {
      "build/x": false, "Build/x": true}},
    {"name": "A.13 empty", "file": "", "paths": {"anything": false, "a/b": false}},
    {"name": "A.13 comments and blanks", "file": "# only a comment\n\n   \n\n", "paths": {"anything": false, "#": false}},
    {"name": "last match wins", "file": "!a\na\n", "paths": {"a": true}},
    {"name": "a lone double star is a star", "file": "**\n", "paths": {"a": true, "a/b": true}},
    {"name": "double star in the middle of a segment", "file": "a**b\n", "paths": {"axxb": true, "a/b": false}},
    {"name": "anchored double star", "file": "/**\n", "paths": {"a": true, "a/b": true}},
    {"name": "several double stars", "file": "**/a/**/b/**\n", "paths": {"a/b/c": true, "x/a/y/b/z": true, "a/b": false}},
    {"name": "escaped star is literal", "file": "\\*.txt\n", "paths": {"*.txt": true, "a.txt": false}},
    {"name": "escaped bracket is literal", "file": "\\[x]\n", "paths": {"[x]": true}},
    {"name": "not bracket-free in a comment", "file": "# [abc]\n", "paths": {"a": false}},
    {"name": "question mark is one character", "file": "?\n", "paths": {"\u00e9": true, "ab": false}},
    {"name": "no normalization", "file": "\u00e9\n", "paths": {"\u00e9": true, "e\u0301": false}},
    {"name": "leading spaces are significant", "file": " a\n", "paths": {" a": true, "a": false}},
    {"name": "CRLF", "file": "a\r\nb\r\n", "paths": {"a": true, "b": true}},
    {"name": "BOM", "file": "\ufeffa\n", "paths": {"a": true}},
    {"name": "directory-only anchored", "file": "src/gen/\n", "paths": {"src/gen/x": true, "src/gen": false, "src/gen/": true, "x/src/gen/y": false}},
