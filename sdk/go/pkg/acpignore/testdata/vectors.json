{
  "comment": "ext-43 Appendix A. A path ending in / is a directory candidate met by a scan; any other path is a file. A client's matcher must give these answers.",
  "cases": [
    {"name": "A.1", "file": "__pycache__/\n", "paths": {
      "__pycache__/a.pyc": true, "src/__pycache__/m.cpython-312.pyc": true, "__pycache__": false, "src/__pycache__x/a.pyc": false, "__pycache__/": true}},
    {"name": "A.2", "file": "*.log\n!keep.log\n", "paths": {
